# Contact form email (copy to .env.local and fill in).
# Without SMTP_HOST and CONTACT_TO, the form shows
# "Your submission failed because of a server error."

# Example for Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Where enquiries are delivered
CONTACT_TO=jowelvisual@gmail.com
# Optional sender address (defaults to SMTP_USER)
CONTACT_FROM=
